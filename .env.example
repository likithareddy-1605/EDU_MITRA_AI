# =============================================================================
# EduMitra AI - Environment Variables Example
# =============================================================================
# DO NOT commit real secrets (.env) to GitHub.
# Copy this template to client/.env and server/.env as needed.

# -----------------------------------------------------------------------------
# 1. Server Environment Variables (server/.env)
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Service Configuration
# Leave blank to run safely in offline demo/localStorage mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (Server-Side Only - Never exposed to frontend)
# Get a free key at https://aistudio.google.com/
# Leave blank to use transparent rule-based deterministic responses.
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 2. Frontend Environment Variables (client/.env or Vercel dashboard)
# -----------------------------------------------------------------------------
# Base URL of Express backend API (or deployed backend URL on Render/Railway/Vercel)
VITE_API_BASE_URL=http://localhost:4000/api

# Supabase Client Configuration (Public Anon Key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
