# EduMitra AI server — environment variables.
# Copy this file to `server/.env` and fill in real values.
# NEVER commit the real `.env` file.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Supabase (Milestone 2) -------------------------------------------------
# Leave blank to run in demo mode (no real database/auth).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (Milestone 3) ---------------------------------------------
# Leave blank to use the clearly-labelled deterministic fallback (no live AI).
GEMINI_API_KEY=
